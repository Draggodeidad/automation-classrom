# Copia este archivo como .env. No confirmes .env en Git.
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Mexico_City
TZ=America/Mexico_City

# Genera con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES

# n8n 2.x bloquea $env en Code/expresiones por defecto. Este workflow sólo
# expone configuración no secreta por $env; OAuth/API keys permanecen en Credentials.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# dry-run consulta Classroom, Drive, GitHub e IA, pero no modifica GitHub.
AUTOMATION_MODE=dry-run

# Se descubren una sola vez durante setup con courses.list.
CLASSROOM_PWA_COURSE_ID=
CLASSROOM_DMI_COURSE_ID=
PWA_REPOSITORY=Draggodeidad/pwa-utt
DMI_REPOSITORY=Draggodeidad/campusops-dmi-team

# Límites defensivos para starters universitarios.
MAX_ZIP_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=100
MAX_ZIP_FILES=500
MAX_SINGLE_FILE_MB=10

# gemini (predeterminado) u ollama
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Gmail es sólo salida opcional; nunca es fuente de actividades.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL=tu-correo@gmail.com

# Retención ligera de ejecuciones: horas y máximo de registros.
EXECUTIONS_DATA_MAX_AGE=24
EXECUTIONS_DATA_PRUNE_MAX_COUNT=500
N8N_LOG_LEVEL=info
