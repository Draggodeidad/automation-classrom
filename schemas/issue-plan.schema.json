{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/classroom-issue-plan.schema.json",
  "title": "ClassroomIssuePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issues"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "assignee",
          "type",
          "priority",
          "dependsOn",
          "sections"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          },
          "assignee": {
            "type": "string",
            "enum": ["Draggodeidad", "JulianDele", "osbaldoXxC"]
          },
          "type": {
            "type": "string",
            "enum": ["feature", "test", "docs", "devops", "evidence"]
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
            }
          },
          "sections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "historiaUsuario",
              "contexto",
              "objetivoTecnico",
              "alcance",
              "fueraDeAlcance",
              "archivosEsperados",
              "pasosSugeridos",
              "criteriosAceptacion",
              "pruebas",
              "dependencias",
              "evidenciaIndividual",
              "definitionOfDone"
            ],
            "properties": {
              "historiaUsuario": {
                "type": "string",
                "minLength": 3
              },
              "contexto": {
                "type": "string",
                "minLength": 3
              },
              "objetivoTecnico": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "alcance": {
                "type": "array",
                "items": { "type": "string" }
              },
              "fueraDeAlcance": {
                "type": "array",
                "items": { "type": "string" }
              },
              "archivosEsperados": {
                "type": "array",
                "items": { "type": "string" }
              },
              "pasosSugeridos": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "criteriosAceptacion": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              },
              "pruebas": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "dependencias": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidenciaIndividual": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "definitionOfDone": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}