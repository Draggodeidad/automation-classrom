{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/classroom-issue-plan.schema.json",
  "title": "ClassroomIssuePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "course",
    "week",
    "repository",
    "assignmentTitle",
    "deadline",
    "source",
    "issues"
  ],
  "properties": {
    "course": {
      "type": "string",
      "enum": ["DMI", "PWA"]
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "repository": {
      "type": "string",
      "enum": [
        "Draggodeidad/campusops-dmi-team",
        "Draggodeidad/pwa-utt"
      ]
    },
    "assignmentTitle": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240
    },
    "deadline": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseId", "courseWorkId", "updateTime", "starterName"],
      "properties": {
        "courseId": { "type": "string", "minLength": 1 },
        "courseWorkId": { "type": "string", "minLength": 1 },
        "updateTime": { "type": "string", "format": "date-time" },
        "starterName": { "type": ["string", "null"] }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "assignee",
          "type",
          "priority",
          "dependsOn",
          "body",
          "expectedFiles",
          "acceptanceCriteria",
          "tests",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          },
          "assignee": {
            "type": "string",
            "enum": ["Draggodeidad", "JulianDele", "osbaldoXxC"]
          },
          "type": {
            "type": "string",
            "enum": ["feature", "test", "docs", "devops", "evidence"]
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
            }
          },
          "body": {
            "type": "string",
            "minLength": 350
          },
          "expectedFiles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
